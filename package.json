{
  "name": "innovo-placement-platform",
  "version": "1.0.0",
  "description": "Unified College Placement Management & Career Governance Platform (Single Port Architecture)",
  "main": "backend/src/server.js",
  "scripts": {
    "start": "node backend/src/server.js",
    "dev": "node start-dev.js",
    "dev:all": "node start-dev.js",
    "dev:backend": "node backend/src/server.js",
    "dev:frontend": "npm run dev --prefix frontend",
    "dev:server": "node backend/src/server.js",
    "dev:client": "npm run dev --prefix frontend",
    "backend": "node backend/src/server.js",
    "frontend": "npm run dev --prefix frontend",
    "server": "node backend/src/server.js",
    "client": "npm run dev --prefix frontend",
    "postinstall": "npm install --prefix frontend",
    "build": "npm run build --prefix frontend && node -e \"const fs=require('fs'); if(fs.existsSync('frontend/dist')){fs.cpSync('frontend/dist','dist',{recursive:true});}\"",
    "vercel-build": "npm run build",
    "test:saas": "npm run test:saas --prefix backend",
    "migrate": "npm run migrate --prefix backend",
    "seed": "npm run seed --prefix backend"
  },
  "devDependencies": {
    "vite": "^8.3.0"
  },
  "keywords": [
    "placement",
    "lms",
    "career-governance",
    "skill-analyzer",
    "resume-analyzer",
    "single-port"
  ],
  "author": "Antigravity Architect",
  "license": "ISC"
}
