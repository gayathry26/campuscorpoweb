{
  "name": "innovo-placement-platform",
  "version": "1.0.0",
  "description": "Unified College Placement Management & Career Governance Platform (Single Port Architecture)",
  "main": "server/src/server.js",
  "scripts": {
    "start": "node server/src/server.js",
    "dev": "node start-dev.js",
    "dev:all": "node start-dev.js",
    "dev:server": "node server/src/server.js",
    "dev:client": "npm run dev --prefix client",
    "server": "node server/src/server.js",
    "client": "npm run dev --prefix client",
    "postinstall": "npm install --prefix client",
    "build": "npm run build --prefix client && node -e \"const fs=require('fs'); if(fs.existsSync('client/dist')){fs.cpSync('client/dist','dist',{recursive:true});}\"",
    "vercel-build": "npm run build",
    "test:saas": "npm run test:saas --prefix server",
    "migrate": "npm run migrate --prefix server",
    "seed": "npm run seed --prefix server"
  },
  "devDependencies": {
    "vite": "^8.3.0"
  },
  "keywords": [
    "placement",
    "lms",
    "career-governance",
    "skill-analyzer",
    "resume-analyzer",
    "single-port"
  ],
  "author": "Antigravity Architect",
  "license": "ISC"
}
