# ==============================================================================
# CampusCorpo Email Configuration (.env)
# ==============================================================================

# Option 1: Resend HTTP API (RECOMMENDED for Vercel, Netlify & Indian ISPs)
# Bypasses all SMTP port blocking & greeting timeouts. Sends in <300ms over HTTPS.
# Get free key (3,000 emails/month free) at: https://resend.com
RESEND_API_KEY=your_resend_api_key_here
RESEND_FROM="CampusCorpo <onboarding@resend.dev>"

# Option 2: GoDaddy Titan SMTP (Nodemailer)
# Official business mailbox for CampusCorpo
SMTP_HOST=smtp.titan.email
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=info@campuscorpo.com
SMTP_PASS=your_titan_mail_password_here

# Mail Routing & Headers
MAIL_FROM=info@campuscorpo.com
MAIL_TO=info@campuscorpo.com
ADMIN_RECIPIENT=info@campuscorpo.com
