# Uniserve Placement LMS Server Configuration
PORT=5000
NODE_ENV=development

# MySQL Central Database Configuration
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_COMMON_NAME=lms
DB_POOL_MAX=20

# JWT Authentication
JWT_SECRET=your_secure_jwt_secret_key_here
JWT_EXPIRES_IN=24h

# File Upload Storage Directory
UPLOAD_DIR=uploads
