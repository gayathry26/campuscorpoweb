# ==============================================================================
# CampusCorp AWS Production Environment Configuration
# ==============================================================================

NODE_ENV=production
PORT=5000

# Amazon RDS MySQL Configuration
DB_HOST=campuscorp-production-db.cxxxxxxxxx.us-east-1.rds.amazonaws.com
DB_PORT=3306
DB_USER=campusadmin
DB_PASSWORD=YOUR_AWS_SECRETS_MANAGER_PASSWORD
DB_COMMON_NAME=lms
DB_PLATFORM_NAME=campuscorp_platform
DB_POOL_MAX=30
DB_TENANT_POOL_MAX=20
DB_PLATFORM_POOL_MAX=15
DB_SSL=true

# JWT Authentication
JWT_SECRET=YOUR_PRODUCTION_GRADE_256BIT_SECRET_KEY
JWT_EXPIRES_IN=24h

# AWS S3 Document Storage
AWS_S3_BUCKET=campuscorp-uploads-prod-xxxx
AWS_REGION=us-east-1
CLOUDFRONT_DOMAIN=d111111abcdef8.cloudfront.net

# Internal AI Microservice (ECS Service Discovery / Cloud Map)
PYTHON_SERVICE_URL=http://ai.campuscorp.local:8000

# Compiler & Assessment Execution Paths inside Docker Container
PYTHON_PATH=python3
COMPILER_GCC_PATH=gcc
COMPILER_GXX_PATH=g++
COMPILER_JAVAC_PATH=javac
COMPILER_JAVA_PATH=java
CODE_EXEC_TIMEOUT_MS=5000

# Upload directory (local fallback if S3 is disabled)
UPLOAD_DIR=uploads
